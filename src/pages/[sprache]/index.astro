---
import Basis from '../../layouts/Basis.astro';
import { SPRACHEN, SEITE, texte } from '../../lib/seite';
import type { Sprache } from '../../lib/seite';
import { alleArtikel, pfadVon, isoTag } from '../../lib/artikel';
import Prompt from '../../components/Prompt.astro';
import { prompt, PROMPTS } from '../../lib/prompts';
import { uebersichtVon, pfadVon as seitenPfad, sichtbar } from '../../lib/navigation';

export function getStaticPaths() {
  return SPRACHEN.map((sprache) => ({ params: { sprache } }));
}

const sprache = Astro.params.sprache as Sprache;
const t = texte(sprache);
const artikel = await alleArtikel(sprache);
const neueste = artikel.slice(0, 3);
const erster = prompt('vorhaben-durchplanen');

/* Die drei Türen zeigen auf die Bereichsübersichten — aber nur, wenn die im
 * Bau verlinkt werden dürfen (`sichtbar`). Bis zum Entwurfsschalter in
 * Schritt 6 stünde hier sonst ein Link auf eine noindex-Seite. */
const tuer = (b: 'aufbau' | 'beitrag' | 'vorgehen') => {
  const e = uebersichtVon(b)!;
  return { titel: e.titel, pfad: sichtbar(e) ? seitenPfad(e, sprache) : null };
};
const tueren = { aufbau: tuer('aufbau'), beitrag: tuer('beitrag'), vorgehen: tuer('vorgehen') };

/* Ausführlicher als nötig, und das mit Absicht: Diese Seite soll von
 * KI-Antwortmaschinen zitierbar sein, und die bauen ihre Antwort aus dem,
 * was sie strukturiert vorfinden — nicht aus dem, was schön aussieht. */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SEITE.name,
  description: t.beschreibungStandard,
  abstract:
    'Erfahrungsberichte über den Aufbau eines privaten Homelabs in der Schweiz: ' +
    'Netzwerk, NAS, lokal laufende KI und ein durchsuchbares Dokumentenarchiv. ' +
    'Geschrieben von einem Nicht-Administrator, mit Zahlen, verworfenen Optionen ' +
    'und den Irrtümern samt ihren Kosten.',
  inLanguage: sprache,
  url: new URL(`/${sprache}/`, Astro.site).href,
  keywords: [
    'Homelab', 'NAS', 'TrueNAS', 'Heimnetzwerk', 'lokale KI', 'Ollama',
    'Dokumentenarchiv', 'Paperless', 'Backup', 'Schweiz', 'Datenschutz',
  ].join(', '),
  author: { '@type': 'Person', name: SEITE.autor.name, description: SEITE.autor.kurzbio },
  publisher: { '@type': 'Person', name: SEITE.autor.name },
  audience: {
    '@type': 'Audience',
    audienceType:
      'Technikinteressierte ohne IT-Beruf, die eigene Infrastruktur zuhause betreiben ' +
      'oder das erwägen',
  },
};
---

<Basis titel="Homelab, mitgeschrieben" sprache={sprache} istStartseite schema={schema}>
  {/* Startseite, zweite Fassung (29.10.2026). Die erste war „erdrückend“
      (Cedric): ein Titel über vier Zeilen, sechs schwere Kastenreihen, neun
      Abschnitte am Stück. Jetzt: weniger Rahmen, mehr Luft, sieben Abschnitte,
      und zuerst die Frage, wohin der Leser will — erst danach, was hier anders
      ist. Die Sechser-Kette steht nur noch im Aufbau, nicht doppelt hier.

      ⚠️ Die Dachzeile heisst nicht „vollständig dokumentiert“ wie im Entwurf
      vom 06.09.: Vollständigkeit ist das Merkmal, das bewusst fehlt. */}
  <div class="py-lesestrom py-start">
    <header class="py-start__kopf">
      <p class="py-start__dach">Ein Homelab, mitgeschrieben</p>
      <h1>Unsere Fotos und Dokumente liegen im Haus. Nicht in einer Cloud.<span class="py-h1-cursor" aria-hidden="true">_</span></h1>
      <p class="py-start__lead">
        Ich habe das im Sommer 2026 neben dem Beruf aufgebaut, für rund CHF 3'700 — und
        dabei jede Messung, jeden Preis und jeden Fehler aufgeschrieben. Damit du es
        nachbauen kannst, ohne dieselben Umwege zu gehen.
      </p>
    </header>

    <dl class="py-kennzahlen">
      <div><dt>82'492</dt><dd>Fotos und Videos, im Haus durchsuchbar</dd></div>
      <div><dt>2 Min.</dt><dd>vom Brief im Kasten bis ins durchsuchbare Archiv</dd></div>
      <div><dt>4</dt><dd>Wege zurück, wenn etwas verloren geht</dd></div>
      <div><dt>CHF 3</dt><dd>im Monat, ohne den Internetanschluss</dd></div>
    </dl>
    <p class="py-zahlen__stand">Stand September 2026 — woher jede Zahl kommt, steht im <a href={tueren.aufbau.pfad ?? `/${sprache}/`}>Aufbau</a>.</p>

    <h2>Wo willst du anfangen?</h2>
    <p>
      Drei Wege durch dasselbe Projekt. Nimm den, der zu deiner Frage passt — am Ende
      jeder Seite findest du den Weg zu den anderen beiden.
    </p>
    <ul class="py-tueren py-breit">
      <li>
        <p class="py-tueren__nr">Wenn du nachbauen willst</p>
        <h3>{tueren.aufbau.pfad ? <a href={tueren.aufbau.pfad}>{tueren.aufbau.titel}</a> : tueren.aufbau.titel}</h3>
        <p>Was bei mir zuhause steht und was es im Alltag tut — jedes Gerät mit Preis, jedes Programm mit der Stelle, an der es mich erwischt hat.</p>
      </li>
      <li>
        <p class="py-tueren__nr">Wenn du an derselben Stelle stehst</p>
        <h3>{tueren.beitrag.pfad ? <a href={tueren.beitrag.pfad}>{tueren.beitrag.titel}</a> : tueren.beitrag.titel}</h3>
        <p>Wie es gelaufen ist, Schritt für Schritt erzählt — mit der Messung dahinter und dem Problem, an dem ich gerade hing.</p>
      </li>
      <li>
        <p class="py-tueren__nr">Wenn du etwas ganz anderes planst</p>
        <h3>{tueren.vorgehen.pfad ? <a href={tueren.vorgehen.pfad}>{tueren.vorgehen.titel}</a> : tueren.vorgehen.titel}</h3>
        <p>Wie man so ein Vorhaben angeht, mit einer KI arbeitet und alles so aufschreibt, dass man es in einem halben Jahr noch versteht. Ganz ohne Technik.</p>
      </li>
    </ul>

    <h2>Nur fünf Minuten Zeit?</h2>
    <p>Dann diese drei Seiten, in dieser Reihenfolge. Danach weisst du, ob das Thema etwas für dich ist.</p>
    <ol class="py-weg">
      <li>
        <h3><a href={`/${sprache}/aufbau/was-es-kann/#s-verlust`}>Was passiert, wenn eine Datei weg ist</a></h3>
        <p>Vier Arten, etwas zu verlieren, und vier Wege zurück. Danach weisst du, warum zwei gespiegelte Platten noch kein Backup sind.</p>
        <p class="py-weg__dauer">2 Minuten</p>
      </li>
      <li>
        <h3><a href={`/${sprache}/aufbau/reihenfolge/`}>In welcher Reihenfolge ich es wieder bauen würde</a></h3>
        <p>Sieben Schritte. Den dritten — die Sicherung, bevor es etwas zu sichern gibt — machen fast alle zu spät.</p>
        <p class="py-weg__dauer">2 Minuten</p>
      </li>
      <li>
        <h3><a href={`/${sprache}/prompts/#ausloeser-statt-termine`}>Deine eigene Wunschliste in einen Plan verwandeln</a></h3>
        <p>Ein Prompt, der zu jedem Vorhaben fragt: Woran merkst du, dass es Zeit dafür ist?</p>
        <p class="py-weg__dauer">1 Minute</p>
      </li>
    </ol>

    <h2>Der erste Schritt kostet nichts</h2>
    <p>
      Für den Anfang brauchst du kein Gerät, sondern einen Plan, der deine eigenen Annahmen
      auf den Tisch legt. Diesen Text kannst du in die KI deiner Wahl kopieren und ihr
      erzählen, was du vorhast — ohne deine Daten herzugeben.
    </p>
    <details class="py-aufklapp">
      <summary>Prompt anzeigen: {erster.titel}</summary>
      <Prompt hinweis={erster.hinweis} sprache={sprache}><div class="py-prompt__vorformatiert">{erster.text}</div></Prompt>
    </details>
    <p class="py-start__klein">
      {PROMPTS.length - 1} weitere davon stehen unter <a href={`/${sprache}/prompts/`}>Alle Prompts</a>.
    </p>

    <h2>Was hier anders ist</h2>
    <ul class="py-merkmale">
      <li><strong>Jede Zahl hat ein Datum.</strong> Wenn ich etwas nur geschätzt habe, steht das dabei.</li>
      <li><strong>Die Fehler stehen drin.</strong> Auch die, die heute noch offen sind.</li>
      <li><strong>Nichts ist verlinkt, um Geld zu verdienen.</strong> Modelle und Preise stehen da, damit du nachrechnen kannst.</li>
      <li><strong>Auch das Vorgehen, nicht nur das Ergebnis.</strong> Der Teil, der sich auf fast jedes Vorhaben übertragen lässt.</li>
    </ul>

    <h2>Zuletzt erschienen</h2>
    {neueste.length === 0 ? (
      <p class="py-schlagwort">Noch kein Artikel veröffentlicht.</p>
    ) : (
      <ul class="py-liste">
        {neueste.map((a) => (
          <li>
            <p class="py-meta">
              <span class="py-meta__eingabe" aria-hidden="true">$</span>
              <time datetime={isoTag(a.data.datum)}>{isoTag(a.data.datum)}</time>
            </p>
            <h3 class="py-liste__titel"><a href={pfadVon(a)}>{a.data.titel}</a></h3>
            <p>{a.data.beschreibung}</p>
          </li>
        ))}
      </ul>
    )}

    <h2>Wer das schreibt</h2>
    <p>
      Ich bin Cedric, kein Systemadministrator, und verdiene mein Geld nicht damit. Gebaut
      habe ich das mit einer KI als Planungspartner und mit der Gewohnheit, jede Zahl
      aufzuschreiben, bevor ich sie vergesse. Was hier steht, ist kein Fachbuch, sondern
      das Protokoll von jemandem, der es zum ersten Mal gemacht hat — ich weiss also noch
      genau, welche Stellen unklar waren. Mehr <a href={`/${sprache}/ueber/`}>über mich und
      diese Seite</a>.
    </p>
  </div>
</Basis>
