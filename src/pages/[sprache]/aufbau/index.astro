---
/* Bereichsübersicht — /<sprache>/aufbau/
 *
 * Titel und Status kommen aus navigation.ts, der Text aus
 * src/content/kapitel/de/aufbau.mdx (Umbau Schritt 3, 28.10.2026). Die Liste
 * der Unterkapitel steht IM Text (<Kapitelliste>), damit sie dort steht, wo
 * sie hingehört — nach dem Rückgrat-Bild, vor dem Handlungsblock.
 */
import Basis from '../../../layouts/Basis.astro';
import Kapitelseite from '../../../components/Kapitelseite.astro';
import { SPRACHEN } from '../../../lib/seite';
import type { Sprache } from '../../../lib/seite';
import { uebersichtVon } from '../../../lib/navigation';

export function getStaticPaths() {
  return SPRACHEN.map((sprache) => ({ params: { sprache } }));
}

const sprache = Astro.params.sprache as Sprache;
const eintrag = uebersichtVon('aufbau')!;
---

<Basis titel={eintrag.titel} beschreibung={eintrag.kurzbeschreibung} sprache={sprache}>
  <div class="py-lesestrom">
    <Kapitelseite eintrag={eintrag} sprache={sprache} />
  </div>
</Basis>
