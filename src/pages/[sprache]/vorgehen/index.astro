---
/* Bereichsübersicht — /<sprache>/vorgehen/
 *
 * Platzhalter (Schritt 1 des Umbaus, 24.09.2026). Titel, Kurzbeschreibung und
 * die Liste der Unterkapitel kommen aus navigation.ts; auf dieser Seite steht
 * kein Seitentitel und kein Pfad zum zweiten Mal.
 */
import Basis from '../../../layouts/Basis.astro';
import Platzhalter from '../../../components/Platzhalter.astro';
import Kapitelliste from '../../../components/Kapitelliste.astro';
import { SPRACHEN } from '../../../lib/seite';
import type { Sprache } from '../../../lib/seite';
import { uebersichtVon } from '../../../lib/navigation';

export function getStaticPaths() {
  return SPRACHEN.map((sprache) => ({ params: { sprache } }));
}

const sprache = Astro.params.sprache as Sprache;
const eintrag = uebersichtVon('vorgehen')!;
---

<Basis titel={eintrag.titel} beschreibung={eintrag.kurzbeschreibung} sprache={sprache}>
  <div class="py-lesestrom">
    <Platzhalter eintrag={eintrag} sprache={sprache} />
    <Kapitelliste bereich="vorgehen" sprache={sprache} />
  </div>
</Basis>
