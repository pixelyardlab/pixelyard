---
/* <Statusmarke> — ein kleines Quadrat in drei Zuständen.
 *
 * 🔑 Die Unterscheidung läuft über die FORM, nicht über die Farbe:
 *   gefüllt      = belegt
 *   halb gefüllt = läuft, Nachweis fehlt
 *   offen        = geplant
 *
 * Farbe kommt zusätzlich dazu und trägt die Aussage nicht allein. Wer
 * rot-grün-blind ist, im Dunkelmodus liest oder die Seite ausdruckt, sieht
 * denselben Unterschied. Eine Marke, die nur farbig funktioniert, ist auf
 * einem Schwarzweissdruck dreimal dasselbe Quadrat.
 *
 * Die Beschriftung steht für den Screenreader daneben — an jedem Eintrag,
 * nicht nur in der Legende. Eine Legende hilft nur, wer sie vorher gelesen hat.
 */
import { texte } from '../lib/seite';
import type { Sprache } from '../lib/seite';
import type { Status } from '../lib/navigation';

interface Props {
  status: Status;
  sprache: Sprache;
  /** In der Legende steht die Beschriftung schon sichtbar daneben. */
  ohneText?: boolean;
}
const { status, sprache, ohneText = false } = Astro.props;
const t = texte(sprache);

const beschriftung: Record<Status, string> = {
  belegt: t.markeBelegt,
  teilweise: t.markeTeilweise,
  geplant: t.markeGeplant,
};
---

<svg
  class="py-status"
  data-status={status}
  viewBox="0 0 10 10"
  width="10"
  height="10"
  aria-hidden="true"
  focusable="false"
>
  {status === 'belegt' && <rect class="py-status__fuell" x="1" y="1" width="8" height="8" />}
  {status === 'teilweise' && (
    <>
      <rect class="py-status__fuell" x="1" y="1" width="4" height="8" />
      <rect class="py-status__rand" x="1.5" y="1.5" width="7" height="7" />
    </>
  )}
  {status === 'geplant' && <rect class="py-status__rand" x="1.5" y="1.5" width="7" height="7" />}
</svg>
{!ohneText && <span class="py-nur-fuer-screenreader">{beschriftung[status]}</span>}
