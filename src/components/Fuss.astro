---
import { SEITE, texte } from '../lib/seite';
import type { Sprache } from '../lib/seite';

interface Props { sprache: Sprache }
const { sprache } = Astro.props;
const t = texte(sprache);
const jahr = new Date().getFullYear();
---

<footer class="py-fuss">
  <div class="py-huelle">
    <ul>
      {/* Impressum und Datenschutz seit 28.08.2026 — Entscheid aus
          claude/entscheid_impressum_datenschutz.md. */}
      <li><a href={`/${sprache}/impressum`}>{t.impressum}</a></li>
      <li><a href={`/${sprache}/datenschutz`}>{t.datenschutz}</a></li>
      <li><a href="/rss.xml">RSS</a></li>
      <li><a href="/llms.txt">llms.txt</a></li>
      <li><a href={`/${sprache}/design`}>Design-System</a></li>
    </ul>
    <p>© {jahr} {SEITE.autor.name}</p>
  </div>
</footer>
