---
/* <Station> — ein Kasten in der <Kette>.
 *
 *   art="aus"  die Station, die das Haus verlässt oder den Ausschlag gibt
 *   art="leer" die Station entfällt — und steht trotzdem da
 */
interface Props {
  /** Kopfzeile, z. B. „1 · Ankommen“ oder „2. Rückweg“.
   *  ⚠️ Die Zahl VOR das Wort, nicht dahinter: Das Adressmuster der
   *  Anonymisierungsprüfung liest ein Wort auf „-weg“ mit nachgestellter Zahl
   *  als Strasse mit Hausnummer — zu Recht. */
  nr: string;
  art?: 'aus' | 'leer';
}
const { nr, art } = Astro.props;
---

<li class:list={['py-kette__station', art && `py-kette__station--${art}`]}>
  <span class="py-kette__nr">{nr}</span>
  <span class="py-kette__text"><slot /></span>
</li>
