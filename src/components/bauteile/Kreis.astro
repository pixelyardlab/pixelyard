---
/* <Kreis> — das Rückgrat-Bild des Vorgehens: Frage · Messen · Entscheiden ·
 * Festhalten · Auslöser — und der Auslöser führt zurück. Aus dem Entwurf
 * „Vorgehen und Stolpersteine" (06.09.2026), Farben aus tokens.css. */
const kaesten = [
  ['Frage', 'Was soll', 'anders werden?'],
  ['Messen', 'Zustand statt', 'Vermutung'],
  ['Entscheiden', 'samt dem,', 'was verworfen wird'],
  ['Festhalten', 'an genau', 'einem Ort'],
];
---

<figure class="py-diagramm py-breit">
  <div class="py-diagramm__rolle">
    <svg viewBox="0 0 900 260" role="img"
      aria-label="Der Kreis des Vorgehens: Frage, Messen, Entscheiden, Festhalten, Auslöser — und der Auslöser führt zurück zur nächsten Frage.">
      <defs>
        <marker id="kr-pfeil" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" class="py-svg__fuell" />
        </marker>
        <marker id="kr-pfeil-hl" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" class="py-svg__hlfuell" />
        </marker>
      </defs>
      <g class="py-svg__schrift">
        {kaesten.map(([name, z1, z2], i) => {
          const x = 20 + i * 180;
          const mitte = x + 75;
          return (
            <g>
              <rect x={x} y="52" width="150" height="72" rx="2" class="py-svg__rahmen" />
              <text x={mitte} y="82" font-size="13" font-weight="600" text-anchor="middle" class="py-svg__text">{name}</text>
              <text x={mitte} y="100" font-size="10.5" text-anchor="middle" class="py-svg__leisetext">{z1}</text>
              <text x={mitte} y="113" font-size="10.5" text-anchor="middle" class="py-svg__leisetext">{z2}</text>
              <line x1={x + 150} y1="88" x2={x + 176} y2="88" class="py-svg__linie" marker-end="url(#kr-pfeil)" />
            </g>
          );
        })}
        <rect x="740" y="52" width="140" height="72" rx="2" class="py-svg__hl" />
        <text x="810" y="82" font-size="13" font-weight="600" text-anchor="middle" class="py-svg__hltext">Auslöser</text>
        <text x="810" y="100" font-size="10.5" text-anchor="middle" class="py-svg__hltext">Woran merke ich,</text>
        <text x="810" y="113" font-size="10.5" text-anchor="middle" class="py-svg__hltext">dass es so weit ist?</text>
        <polyline points="810,124 810,178 95,178 95,128" class="py-svg__hl" marker-end="url(#kr-pfeil-hl)" />
        <text x="452" y="170" font-size="11" font-weight="600" text-anchor="middle" class="py-svg__hltext">der Auslöser bringt das Vorhaben zurück — nicht ein Datum</text>
        <line x1="20" y1="212" x2="880" y2="212" class="py-svg__linie py-svg__leise" />
        <text x="20" y="236" font-size="11.5" class="py-svg__leisetext">Wer den letzten Kasten weglässt, hat eine Wunschliste statt eines Plans.</text>
      </g>
    </svg>
  </div>
  <figcaption>
    <strong>Der Kreis.</strong> Jeder Punkt dieses Projekts hat diese fünf Stationen
    durchlaufen. Der fünfte ist der, den fast alle weglassen — und er ist der Grund, warum
    ein Vorhaben von selbst wieder auf den Tisch kommt, statt in einer Liste zu verstauben.
  </figcaption>
</figure>
