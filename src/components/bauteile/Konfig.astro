---
/* <Konfig> — einer von höchstens DREI Konfigurationsblöcken (Entscheid
 * 07.09.2026): am Ende der passenden Unterseite, immer mit Platzhaltern.
 *
 * 🔑 Der Unterschied zwischen nachvollziehbar und nachbaubar. Der Rahmen sagt
 * ausdrücklich, dass es eine FORM ist und kein Original — ein kopierter Block
 * mit echten Werten wäre genau der Fehler, vor dem „Ohne Daten" warnt.
 */
interface Props {
  titel: string;
  /** Anker. Andere Seiten verlinken `#zum-nachbauen`. */
  id?: string;
}
const { titel, id = 'zum-nachbauen' } = Astro.props;
---

<section class="py-konfig py-breit" id={id} aria-label={titel}>
  <p class="py-konfig__marke">Zum Abschreiben · {titel}</p>
  <slot />
  <p class="py-konfig__hinweis">
    Was in spitzen Klammern steht, setzt du selbst ein. Die Zeilen zeigen die Form,
    nicht meine Werte — deine eigenen gehören in deine Ablage, nicht in einen Chat.
  </p>
</section>
