---
/* <Bauteil> — eine Karte nach Vorlage B:
 *   Rolle im System · Modell und Preis MIT DATUM, OHNE LINK · warum so · die Falle
 *
 * 🔑 Kein Link, auch kein Herstellerlink (Entscheid 24.09.2026). Ein Link
 * neben einem Preis liest sich als Kaufempfehlung — und eine Empfehlung ohne
 * Messung ist genau das Füllmaterial, gegen das diese Seite steht.
 *
 * Die Falle kommt als eigenes Bauteil <Falle> am Ende des Inhalts.
 * ⚠️ Nicht als benannter Slot (`<div slot="falle">`): Aus MDX heraus kommt das
 * Attribut nicht als Slot an, sondern landet als gewöhnliches <div> im Text —
 * Bau grün, Beschriftung und Trennlinie fehlen. Am 28.10.2026 so gebaut und
 * erst im Bild bemerkt.
 */
interface Props {
  rolle: string;
  titel: string;
  /** Modellbezeichnung, ausgeschrieben. */
  modell?: string;
  /** Preis samt Zeitpunkt, z. B. „CHF 576 · Sommer 2026" oder „Bestand". */
  preis?: string;
}
const { rolle, titel, modell, preis } = Astro.props;
---

<article class="py-bauteil">
  <p class="py-bauteil__rolle">{rolle}</p>
  <h3 class="py-bauteil__titel">{titel}</h3>
  {modell && <p class="py-bauteil__modell">{modell}</p>}
  {preis && <p class="py-bauteil__preis">{preis}</p>}
  <div class="py-bauteil__warum"><slot /></div>
</article>
