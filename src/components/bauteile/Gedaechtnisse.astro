---
/* <Gedaechtnisse> — drei Kanäle, zwei bleibende Gedächtnisse, zwei fehlende
 * Pfeile. Aus dem Entwurf „Vorgehen und Stolpersteine" (06.09.2026). */
---

<figure class="py-diagramm py-breit">
  <div class="py-diagramm__rolle">
    <svg viewBox="0 0 900 255" role="img"
      aria-label="Drei Kanäle und zwei bleibende Gedächtnisse: kein Pfeil führt von der Terminal-Sitzung zu den gesammelten Entscheiden und keiner vom Gespräch zur Regeldatei.">
      <defs>
        <marker id="gd-pfeil" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" class="py-svg__fuell" />
        </marker>
      </defs>
      <g class="py-svg__schrift">
        <rect x="20" y="30" width="230" height="52" rx="2" class="py-svg__rahmen" />
        <rect x="20" y="98" width="230" height="52" rx="2" class="py-svg__rahmen" />
        <rect x="20" y="166" width="230" height="52" rx="2" class="py-svg__rahmen" />
        <text x="36" y="52" font-size="12.5" font-weight="600" class="py-svg__text">Gespräch in der App</text>
        <text x="36" y="120" font-size="12.5" font-weight="600" class="py-svg__text">Arbeitssitzung</text>
        <text x="36" y="188" font-size="12.5" font-weight="600" class="py-svg__text">Terminal-Sitzung</text>
        <text x="36" y="68" font-size="10.5" class="py-svg__leisetext">Handy oder Browser</text>
        <text x="36" y="136" font-size="10.5" class="py-svg__leisetext">am eigenen Rechner</text>
        <text x="36" y="204" font-size="10.5" class="py-svg__leisetext">mit Kommandozeile</text>

        <rect x="560" y="34" width="320" height="72" rx="2" class="py-svg__hl" />
        <rect x="560" y="142" width="320" height="72" rx="2" class="py-svg__hl" />
        <text x="578" y="58" font-size="12.5" font-weight="600" class="py-svg__hltext">Die gesammelten Entscheide</text>
        <text x="578" y="166" font-size="12.5" font-weight="600" class="py-svg__hltext">Die Regeldatei im Projektordner</text>
        <text x="578" y="76" font-size="10.5" class="py-svg__leisetext">Begründungen, Verworfenes, Runbooks</text>
        <text x="578" y="92" font-size="10.5" class="py-svg__leisetext">— gelesen von den oberen beiden</text>
        <text x="578" y="184" font-size="10.5" class="py-svg__leisetext">Sprache, Stil, Prüfregeln</text>
        <text x="578" y="200" font-size="10.5" class="py-svg__leisetext">— gelesen von den Code-Oberflächen</text>

        <line x1="250" y1="56" x2="554" y2="62" class="py-svg__linie" marker-end="url(#gd-pfeil)" />
        <line x1="250" y1="124" x2="554" y2="80" class="py-svg__linie" marker-end="url(#gd-pfeil)" />
        <line x1="250" y1="192" x2="554" y2="178" class="py-svg__linie" marker-end="url(#gd-pfeil)" />

        <line x1="20" y1="232" x2="880" y2="232" class="py-svg__linie py-svg__leise" />
        <text x="20" y="250" font-size="11.5" class="py-svg__leisetext">Kein Pfeil vom Terminal zu den Entscheiden. Keiner vom Gespräch zur Regeldatei. Das sind die zwei Lücken.</text>
      </g>
    </svg>
  </div>
  <figcaption>
    <strong>Drei Kanäle, zwei bleibende Gedächtnisse.</strong> Das dritte ist die laufende
    Sitzung — schnell, reichhaltig und mit dem Fenster vorbei. Eine Regel wirkt nur dort,
    wo sie steht: Eine Regel fürs Programmieren gehört in die Regeldatei, ein Entscheid
    fürs Gespräch in die Notizen.
  </figcaption>
</figure>
