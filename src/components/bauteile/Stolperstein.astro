---
/* <Stolperstein> — ein Typ, nicht eine Anekdote.
 *
 * 🔑 Nach Typ sortiert, nicht chronologisch: Wer den Typ kennt, erkennt den
 * nächsten Fall auch dann, wenn er ganz anders aussieht. Deshalb zwei Hälften —
 * links das Beispiel aus dem Projekt, rechts <Gegenmittel>: woran man ihn
 * erkennt und was hilft. (Kein benannter Slot — s. Bauteil.astro.)
 */
interface Props {
  nr: number;
  titel: string;
  /** Zusatz hinter „Typ n", z. B. „der teuerste". */
  zusatz?: string;
}
const { nr, titel, zusatz } = Astro.props;
---

<article class="py-stolperstein" id={`typ-${nr}`}>
  <p class="py-stolperstein__typ">Typ {nr}{zusatz && ` · ${zusatz}`}</p>
  <h3>{titel}</h3>
  <slot />
</article>
