---
/* <Stand> — die Zeile am Fuss jeder Kapitelseite.
 *
 * 🔑 „Übersicht, keine Betriebsdokumentation": Die Seite beschreibt einen
 * Stand und wird nicht bei jeder Änderung nachgezogen. Ein Bauplan mit Datum
 * ist ehrlicher als ein Stand, dem man nicht ansieht, wie alt er ist.
 */
interface Props {
  stand: Date;
}
const { stand } = Astro.props;
const monat = stand.toLocaleDateString('de-CH', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<p class="py-stand">
  So sah es im {monat} aus. Ich ziehe diese Seite nicht bei jeder Änderung nach —
  was sich ändert, bekommt einen eigenen Beitrag.
</p>
