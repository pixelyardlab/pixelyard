#!/usr/bin/env bash
#
# artikel — der Weg vom fertigen Text bis zur gemessenen Seite, als ein Befehl.
#
#   ./werkzeuge/artikel
#
# Aufruf ohne Argumente: ein Menue. Nichts zu merken, nichts zu tippen ausser
# einer Zahl. Jeder schreibende Schritt fragt vorher, und zeigt vorher, was er
# tun wuerde.
#
# Warum es das gibt: Der Weg aus `claude/runbook_artikel_uebergabe_2026-08-29.md`
# hat neun Schritte, und drei davon sind still. Der stillste ist der
# Entwurfsschalter: `entwurf: true` erzeugt einen gruenen Bau und eine fehlende
# Seite — 404, nicht bloss unverlinkt. Am 29.08.2026 stand er beim ersten
# Artikel eine Handbewegung vor dem Deploy noch auf `true`.
#
# 🔑 Dieses Skript gibt NIE einen Klarwert aus, nur Datei und Zeilennummer —
#    dieselbe Regel wie in werkzeuge/anonymisierung-pruefen.sh. Seine Ausgabe
#    laesst sich gefahrlos weitergeben, auch an einen Assistenten.
#
# ⚠️ Was dieses Skript NICHT kann: sehen. Ob ein Diagramm blass wirkt, ob ein
#    Bild eine Adresse im Hintergrund hat, ob ein Satz einen Ortshinweis traegt
#    — das sieht nur ein Mensch. Die Sichtabnahme steht im Menue als eigener
#    Punkt, damit sie nicht dadurch verschwindet, dass alles andere gruen ist.
#
# Bewusst bash 3.2: das ist die Version, die auf einem Mac ohne Homebrew liegt.
# Keine assoziativen Arrays, kein mapfile, keine Abhaengigkeiten.

set -u

REPO="$(cd "$(dirname "$0")/.." && pwd)"
UEBERGABE="${BLOG_UEBERGABE:-$HOME/Downloads/blogbeitraege}"
ERLEDIGT="$UEBERGABE/erledigt"
ZIEL_BASIS="$REPO/src/content/artikel"
PRUEFSKRIPT="$REPO/werkzeuge/anonymisierung-pruefen.sh"
SEITE="https://www.pixelyard.ch"

# --- Ausgabe --------------------------------------------------------------

OK="✅"; WARN="⚠️ "; ROT="🔴"; INFO="  ·"
BEFUNDE=0
WARNUNGEN=0

titel()  { echo; echo "=== $* ==="; echo; }
ok()     { echo "$OK $*"; }
warn()   { echo "$WARN $*"; WARNUNGEN=$((WARNUNGEN + 1)); }
rot()    { echo "$ROT $*"; BEFUNDE=$((BEFUNDE + 1)); }
info()   { echo "$INFO $*"; }
weiter() { echo; printf "    [Enter] weiter "; read -r _; }

frage() {
  # frage "Text" -> 0 bei ja. Standard ist NEIN; Enter heisst abbrechen.
  local antwort
  echo
  printf "    %s [j/N] " "$1"
  read -r antwort
  case "$antwort" in [jJyY]*) return 0 ;; *) echo "    abgebrochen."; return 1 ;; esac
}

# --- Frontmatter ----------------------------------------------------------

frontmatter() {
  # Gibt den Block zwischen der ersten und zweiten '---'-Zeile aus.
  awk 'NR==1 && $0!="---" {exit} NR==1 {next} /^---[[:space:]]*$/ {exit} {print}' "$1"
}

feld() {
  # feld <datei> <name> -> Wert ohne Anfuehrungszeichen, leer wenn nicht da.
  frontmatter "$1" | awk -v f="$2" '
    $0 ~ "^" f ":" {
      sub("^" f ":[[:space:]]*", "")
      gsub(/^"|"$/, "")
      print
      exit
    }'
}

slug_von() { basename "$1" .mdx; }

# --- Kandidaten -----------------------------------------------------------

kandidaten() {
  # Alle .mdx im Uebergabeordner, neueste zuerst.
  [ -d "$UEBERGABE" ] || return 0
  ls -t "$UEBERGABE"/*.mdx 2>/dev/null
}

raeume_weg() {
  # raeume_weg <datei-im-uebergabeordner> — verschiebt nach erledigt/.
  # Verschieben, nicht loeschen: die Fassung, die an Claude Code ging, bleibt
  # nachlesbar. Ab dem Commit ist trotzdem das Repo die Quelle — der Ordner
  # heisst deshalb erledigt und nicht archiv.
  local d="$1" ziel
  [ -e "$d" ] || return 1
  mkdir -p "$ERLEDIGT"
  ziel="$ERLEDIGT/$(basename "$d")"
  if [ -e "$ziel" ]; then
    ziel="$ERLEDIGT/$(slug_von "$d")-$(date +%Y%m%d).mdx"
    info "Am Ziel lag schon eine Fassung — die neue heisst $(basename "$ziel")"
  fi
  mv "$d" "$ziel" && ok "verschoben nach erledigt/$(basename "$ziel")"
}

schritt_raeumen() {
  local d slug gebaut anzahl
  titel "Uebergabeordner aufraeumen"
  echo "Was im Repo als Artikel liegt und dort nicht mehr auf Entwurf steht,"
  echo "ist erledigt — die Fassung im Uebergabeordner ist ab dem Commit nur noch"
  echo "Herkunft, keine Quelle mehr."
  echo
  if [ -z "$(kandidaten)" ]; then echo "$INFO Nichts da."; weiter; return; fi
  anzahl=0
  for d in $(kandidaten); do
    slug=$(slug_von "$d")
    gebaut=""
    for f in "$ZIEL_BASIS"/*/"$slug.mdx"; do [ -e "$f" ] && gebaut="$f"; done
    if [ -n "$gebaut" ] && [ "$(feld "$gebaut" entwurf)" != "true" ]; then
      echo "   $(basename "$d")  ->  erledigt/   (im Repo live seit $(feld "$gebaut" datum))"
      anzahl=$((anzahl + 1))
    else
      if [ -n "$gebaut" ]; then echo "   $(basename "$d")  bleibt liegen — im Repo noch Entwurf"
      else echo "   $(basename "$d")  bleibt liegen — im Repo nicht vorhanden"; fi
    fi
  done
  [ "$anzahl" -eq 0 ] && { echo; echo "$INFO Nichts zu verschieben."; weiter; return; }
  frage "Die oben markierten verschieben?" || { weiter; return; }
  for d in $(kandidaten); do
    slug=$(slug_von "$d")
    gebaut=""
    for f in "$ZIEL_BASIS"/*/"$slug.mdx"; do [ -e "$f" ] && gebaut="$f"; done
    if [ -n "$gebaut" ] && [ "$(feld "$gebaut" entwurf)" != "true" ]; then raeume_weg "$d"; fi
  done
  weiter
}

waehle_datei() {
  # Setzt GEWAEHLT. Bei genau einem Kandidaten ohne Rueckfrage.
  local liste anzahl i n auswahl
  liste=$(kandidaten)
  if [ -z "$liste" ]; then
    echo "$ROT Keine .mdx in $UEBERGABE"
    echo "$INFO Dort legt das Homelab-Projekt den fertigen Artikel ab."
    return 1
  fi
  anzahl=$(echo "$liste" | wc -l | tr -d ' ')
  if [ "$anzahl" = "1" ]; then GEWAEHLT="$liste"; return 0; fi
  echo "Mehrere Artikel im Uebergabeordner:"
  echo
  i=1
  echo "$liste" | while read -r n; do echo "   $i) $(basename "$n")"; i=$((i + 1)); done
  printf "\n    Nummer: "
  read -r auswahl
  GEWAEHLT=$(echo "$liste" | sed -n "${auswahl}p")
  [ -n "$GEWAEHLT" ] || { echo "$ROT Keine gueltige Auswahl."; return 1; }
  return 0
}

# --- Die Pruefungen -------------------------------------------------------

pruefe_schema() {
  local d="$1" slug wert fehlend f
  slug=$(slug_von "$d")
  echo "-- Frontmatter gegen src/content.config.ts"

  head -1 "$d" | grep -q '^---' || { rot "Die Datei beginnt nicht mit '---'. Kein Frontmatter, der Bau bricht ab."; return; }

  fehlend=""
  for f in titel beschreibung datum paar; do
    [ -n "$(feld "$d" "$f")" ] || fehlend="$fehlend $f"
  done
  if [ -n "$fehlend" ]; then rot "Pflichtfelder fehlen:$fehlend"; else ok "Pflichtfelder da: titel, beschreibung, datum, paar"; fi

  # Felder, die es im Schema nicht gibt. Sie sehen richtig aus und sind es nicht.
  for f in title description pubDate tags draft author; do
    if frontmatter "$d" | grep -q "^$f:"; then
      rot "Feld '$f' gibt es im Schema nicht — gemeint ist wohl das deutsche Gegenstueck."
    fi
  done

  wert=$(feld "$d" "paar")
  if [ -n "$wert" ] && [ "$wert" != "$slug" ]; then
    rot "paar ('$wert') und Dateiname ('$slug') stimmen nicht ueberein — davon haengt hreflang."
  elif [ -n "$wert" ]; then
    ok "paar stimmt mit dem Dateinamen ueberein"
  fi

  wert=$(feld "$d" "datum")
  if echo "$wert" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'; then
    if [ "$wert" = "$(date +%Y-%m-%d)" ]; then ok "datum ist heute ($wert)"
    else warn "datum ist $wert, heute ist $(date +%Y-%m-%d) — bewusst so?"; fi
  else
    rot "datum ist kein Datum im Format JJJJ-MM-TT: '$wert'"
  fi

  wert=$(feld "$d" "sprache")
  case "${wert:-de}" in
    de|en) ok "sprache: ${wert:-de (Standard)}" ;;
    *) rot "sprache '$wert' ist weder de noch en" ;;
  esac
}

pruefe_entwurf() {
  # $2: "erwartet_true" oder "erwartet_false"
  local d="$1" erwartet="$2" zeile wert
  echo
  echo "-- Der Entwurfsschalter"
  zeile=$(grep -n '^entwurf:' "$d" | head -1)
  if [ -z "$zeile" ]; then
    rot "Kein Feld 'entwurf'. Der Standard im Schema ist FALSE — der Artikel ginge mit dem naechsten Push live."
    return
  fi
  wert=$(feld "$d" "entwurf")
  info "Zeile ${zeile%%:*}: entwurf: $wert"
  if [ "$erwartet" = "erwartet_true" ]; then
    if [ "$wert" = "true" ]; then ok "entwurf: true — richtig fuer die Uebernahme ins Repo"
    else rot "entwurf steht auf '$wert'. Fuer die Uebernahme gehoert er auf true."; fi
  else
    if [ "$wert" = "false" ]; then ok "entwurf: false — die Seite wird gebaut"
    else rot "entwurf steht auf '$wert'. Der Bau waere gruen und die Seite fehlte — 404, nicht bloss unverlinkt."; fi
  fi
}

pruefe_bauteile() {
  local d="$1" n erstes
  echo
  echo "-- Editorial-Bauteile"
  n=$(grep -c '<TLDR>' "$d")
  erstes=$(awk 'NR>1 && /^---[[:space:]]*$/ {gefunden=1; next} gefunden && NF {print; exit}' "$d")
  if [ "$n" = "1" ]; then
    case "$erstes" in
      "<TLDR>"*) ok "TL;DR: 1, und steht als erstes Element" ;;
      *) warn "TL;DR ist da, steht aber nicht als erstes Element im Text" ;;
    esac
  elif [ "$n" = "0" ]; then warn "Kein <TLDR> — bewusst so?"
  else rot "$n mal <TLDR>. Es gehoert genau eines an den Anfang."; fi

  info "Erklaerungen: $(grep -c '<Erklaerung>' "$d") · Prompts: $(grep -c '<Prompt>' "$d") · FAQ-Eintraege: $(frontmatter "$d" | grep -c '^  - frage:')"

  if grep -q '<Prompt>' "$d"; then
    if grep -q 'Lade keine' "$d"; then ok "Prompt-Box enthaelt den Hinweis 'Lade keine ... hoch'"
    else rot "Prompt-Box ohne den Hinweis, nichts hochzuladen — Editorial-Regel."; fi
  fi

  if grep -q '<Affiliatelink' "$d"; then
    warn "<Affiliatelink> gesetzt: nur zulaessig, wenn der Link eine Provisionskennung traegt. Sonst normaler Markdown-Link."
  fi

  echo
  echo "-- Erklaerungsboxen unter der Messregel (Befund 29.08.)"
  info "Die Boxen werden als neutrale Definition gelesen und deshalb weniger streng geprueft."
  info "Jede Box einmal selbst lesen: steht darin eine Behauptung, die eine Messung waere?"
}

pruefe_muster() {
  # Nur Zeilennummern, nie der Fund selbst.
  local d="$1" treffer name muster
  echo
  echo "-- Strukturelle Muster (Ausgabe ohne Klarwerte)"
  set -- \
    "IP-Adresse:([0-9]{1,3}\.){3}[0-9]{1,3}" \
    "MAC-Adresse:([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}" \
    "Hostname .local/.arpa:[a-z0-9-]+\.(local|arpa)\b" \
    "VLAN-Nummer:VLAN ?[0-9]+" \
    "Beleg-/Seriennummer:(Beleg|Bestell|Kunden|Serien)\w*nummer" \
    "deutsches Eszett:ß"
  for eintrag in "$@"; do
    name="${eintrag%%:*}"; muster="${eintrag#*:}"
    treffer=$(grep -nE "$muster" "$d" | cut -d: -f1 | tr '\n' ' ')
    if [ -n "$treffer" ]; then rot "$name — Zeile(n): $treffer"; fi
  done
  [ "$BEFUNDE" -eq 0 ] && ok "Keine strukturellen Muster gefunden"

  echo
  echo "-- Was die Muster nicht finden"
  info "Ortshinweise in Prosa ('als unsere Strasse angeschlossen wurde')"
  info "unbelegte Aussagen ('kein einziges Byte')"
  info "Anbieter + Zeitpunkt im selben Absatz — die Kombination lokalisiert, nicht der Einzelwert"
  info "Topologie in Diagrammen · Etiketten und Adressen auf Bildern"
}

pruefe_technik() {
  local d="$1" treffer woerter
  echo
  echo "-- Technische Fallen"
  treffer=$(grep -n '^```mermaid' "$d" | cut -d: -f1 | tr '\n' ' ')
  if [ -n "$treffer" ]; then
    rot "Mermaid-Codeblock in Zeile(n): $treffer — es gibt kein Mermaid-Plugin. Quelle als Kommentar, Bild als SVG."
  else ok "Kein roher Mermaid-Block"; fi

  treffer=$(grep -n "$SEITE" "$d" | cut -d: -f1 | tr '\n' ' ')
  if [ -n "$treffer" ]; then
    warn "Absoluter interner Link in Zeile(n): $treffer — bekaeme target=_blank. Intern relativ schreiben."
  fi

  if grep -q '<svg' "$d"; then
    treffer=$(grep -n 'py-line' "$d" | cut -d: -f1 | tr '\n' ' ')
    if [ -n "$treffer" ]; then rot "--py-line im SVG, Zeile(n): $treffer — Kontrast 1.31/1.46, nur als Zierlinie auf --py-bg zulaessig."
    else ok "SVG vorhanden, kein --py-line darin"; fi
    info "Kontrast gehoert gerechnet: 4.5:1 fuer Text, 3:1 fuer Linien und Flaechen."
  fi

  # Fliesstext ohne Frontmatter, ohne Diagramm-Markup, ohne Kommentare.
  woerter=$(awk '
    NR==1 && $0 ~ /^---/ {fm=1; next}
    fm==1 && /^---[[:space:]]*$/ {fm=0; next}
    fm==1 {next}
    /\{\/\*/ {kom=1}
    kom==1 {if (/\*\/\}/) kom=0; next}
    /<figure>/ {fig=1}
    fig==1 {if (/<\/figure>/) fig=0; next}
    {gsub(/<[^>]*>/, ""); n += NF}
    END {print n + 0}' "$d")
  info "Fliesstext: rund $woerter Woerter (ohne Frontmatter, Diagramm und Kommentare)"
}

pruefe_datei() {
  local d="$1" modus="$2"
  BEFUNDE=0; WARNUNGEN=0
  titel "Pruefe $(basename "$d")"
  pruefe_schema "$d"
  pruefe_entwurf "$d" "$modus"
  pruefe_bauteile "$d"
  pruefe_muster "$d"
  pruefe_technik "$d"
  echo
  if [ "$BEFUNDE" -eq 0 ]; then
    echo "$OK Kein Befund, $WARNUNGEN Hinweis(e)."
    echo "$INFO Das heisst: keine der Pruefungen oben hat angeschlagen. Es heisst nicht,"
    echo "$INFO dass der Text stimmt — gelesen und angesehen hat ihn noch niemand."
    return 0
  else
    echo "$ROT $BEFUNDE Befund(e), $WARNUNGEN Hinweis(e). Anhalten."
    return 1
  fi
}

# --- Die Schritte ---------------------------------------------------------

schritt_lage() {
  local d slug zustand n
  titel "Lage"
  echo "Repo:          $REPO"
  echo "Uebergabe:     $UEBERGABE"
  echo
  echo "Im Uebergabeordner:"
  if [ -z "$(kandidaten)" ]; then echo "   (leer)"; else
    for d in $(kandidaten); do echo "   $(basename "$d")   entwurf: $(feld "$d" entwurf)"; done
  fi
  n=$(ls "$ERLEDIGT"/*.mdx 2>/dev/null | wc -l | tr -d ' ')
  [ "$n" != "0" ] && echo "   erledigt/: $n abgelegte Fassung(en)"
  echo
  echo "Im Repo:"
  for d in "$ZIEL_BASIS"/*/*.mdx; do
    [ -e "$d" ] || continue
    zustand=$(feld "$d" entwurf)
    case "$zustand" in
      true)  zustand="ENTWURF — wird nicht gebaut" ;;
      false|"") zustand="live" ;;
    esac
    echo "   ${d#$ZIEL_BASIS/}   $zustand   $(feld "$d" datum)"
  done
  echo
  if command -v git >/dev/null 2>&1 && [ -d "$REPO/.git" ]; then
    echo "Git:"
    echo "   Zweig:        $(cd "$REPO" && git rev-parse --abbrev-ref HEAD 2>/dev/null)"
    echo "   Letzter:      $(cd "$REPO" && git log -1 --format='%h %s' 2>/dev/null)"
    n=$(cd "$REPO" && git status --porcelain | wc -l | tr -d ' ')
    if [ "$n" = "0" ]; then echo "   Arbeitsbaum:  sauber"
    else echo "   Arbeitsbaum:  $n geaenderte Datei(en)"; (cd "$REPO" && git status --short | sed 's/^/                 /'); fi
  else
    echo "Git: nicht gefunden oder kein Repo an dieser Stelle."
  fi
  weiter
}

schritt_pruefen() {
  waehle_datei || { weiter; return; }
  pruefe_datei "$GEWAEHLT" erwartet_true
  weiter
}

schritt_uebernehmen() {
  local sprache slug ziel
  waehle_datei || { weiter; return; }
  pruefe_datei "$GEWAEHLT" erwartet_true || {
    frage "Trotz Befund uebernehmen?" || { weiter; return; }
  }
  sprache=$(feld "$GEWAEHLT" sprache); sprache="${sprache:-de}"
  slug=$(slug_von "$GEWAEHLT")
  ziel="$ZIEL_BASIS/$sprache/$slug.mdx"

  titel "Ins Repo uebernehmen"
  echo "    von:  $GEWAEHLT"
  echo "    nach: $ziel"
  echo
  echo "$INFO Das Original bleibt im Uebergabeordner liegen — kopiert, nicht verschoben."
  if [ -e "$ziel" ]; then
    warn "Am Ziel liegt schon eine Datei. Unterschiede:"
    diff "$ziel" "$GEWAEHLT" | head -40
    frage "Bestehende Datei ueberschreiben?" || { weiter; return; }
  fi
  frage "Kopieren?" || { weiter; return; }
  mkdir -p "$(dirname "$ziel")"
  cp "$GEWAEHLT" "$ziel" && ok "kopiert"

  echo
  echo "-- Anonymisierungs-Pruefskript ueber den Arbeitsbaum"
  if [ -x "$PRUEFSKRIPT" ]; then "$PRUEFSKRIPT"; else warn "$PRUEFSKRIPT nicht gefunden oder nicht ausfuehrbar"; fi

  echo
  echo "-- Bau"
  bau_und_pruefe "$slug" "$sprache" erwartet_entwurf
  echo
  echo "$INFO Naechster Schritt: Vorschau (Menuepunkt 4) — hell UND dunkel ansehen."
  weiter
}

bau_und_pruefe() {
  # bau_und_pruefe <slug> <sprache> <erwartet_entwurf|erwartet_live>
  local slug="$1" sprache="$2" modus="$3" vorher nachher ausgabe f
  if ! command -v npm >/dev/null 2>&1; then warn "npm nicht gefunden — Bau uebersprungen."; return 1; fi
  vorher=$(find "$REPO/dist" -name '*.html' 2>/dev/null | wc -l | tr -d ' ')
  ausgabe=$( (cd "$REPO" && npm run build 2>&1) )
  if [ $? -ne 0 ]; then
    rot "Der Bau ist fehlgeschlagen. Letzte Zeilen:"
    echo "$ausgabe" | tail -25
    return 1
  fi
  nachher=$(find "$REPO/dist" -name '*.html' 2>/dev/null | wc -l | tr -d ' ')
  ok "Bau gruen — Seiten im Bau: $nachher (vorher $vorher)"
  echo
  echo "-- Was im Bau tatsaechlich angekommen ist"
  if [ -e "$REPO/dist/$sprache/artikel/$slug/index.html" ]; then
    if [ "$modus" = "erwartet_entwurf" ]; then
      rot "Die Seite wurde gebaut, obwohl der Artikel ein Entwurf sein soll. Entwurfsschalter pruefen."
    else ok "Seite gebaut: dist/$sprache/artikel/$slug/index.html"; fi
  else
    if [ "$modus" = "erwartet_entwurf" ]; then
      ok "Keine Seite gebaut — genau das tut ein Entwurf. Sichtbar nur im Dev-Server."
    else
      rot "KEINE Seite gebaut. Ein gruener Bau ohne Seite heisst 404. Entwurfsschalter pruefen."
    fi
  fi
  if [ "$modus" = "erwartet_live" ]; then
    for f in "$sprache/index.html" "rss.xml" "sitemap-0.xml" "llms.txt"; do
      if [ -e "$REPO/dist/$f" ] && grep -q "$slug" "$REPO/dist/$f"; then ok "in dist/$f"
      else rot "NICHT in dist/$f — alle vier ziehen aus derselben Funktion, es fehlt sonst ueberall."; fi
    done
  fi
  return 0
}

schritt_vorschau() {
  titel "Vorschau im Dev-Server"
  echo "Der Dev-Server zeigt Entwuerfe, der Bau nicht. Genau dafuer ist er da."
  echo
  echo "$INFO Ansehen, was kein Skript sieht:"
  echo "$INFO   hell UND dunkel · Desktop UND Handy"
  echo "$INFO   Diagramm: blass? Beschriftung lesbar?"
  echo "$INFO   Bilder: Etiketten, Seriennummern, Adressen im Hintergrund?"
  echo "$INFO   Text: Ortshinweise, Zusagen ohne Messung, doppelte Pointen aus frueheren Artikeln"
  echo
  echo "    Beenden mit Ctrl-C, danach steht das Menue wieder da."
  frage "Dev-Server jetzt starten?" || { weiter; return; }
  (cd "$REPO" && npm run dev)
  weiter
}

schritt_freigabe() {
  local sprache slug ziel wert heute
  titel "Freigabe und Livegang"
  echo "Ab hier wird veroeffentlicht. Jeder Schritt fragt vorher."
  echo
  printf "    Welcher Artikel (Dateiname ohne .mdx)? "
  read -r slug
  sprache="de"
  ziel="$ZIEL_BASIS/$sprache/$slug.mdx"
  [ -e "$ziel" ] || ziel="$ZIEL_BASIS/en/$slug.mdx"
  [ -e "$ziel" ] || { echo "$ROT Nicht gefunden im Repo: $slug"; weiter; return; }
  sprache=$(basename "$(dirname "$ziel")")

  echo
  echo "-- Vor dem Umlegen"
  echo "$INFO Sichtabnahme hell und dunkel gemacht? Wenn nein: Menuepunkt 4, nicht weiter hier."
  frage "Gesehen und in Ordnung?" || { weiter; return; }

  wert=$(feld "$ziel" entwurf)
  if [ "$wert" != "false" ]; then
    echo
    echo "    entwurf: $wert  ->  entwurf: false"
    frage "Entwurfsschalter jetzt umlegen?" || { weiter; return; }
    # Punktgenau die eine Zeile, ohne Datumsformate oder Umlaute anzufassen.
    sed -i.bak 's/^entwurf:.*/entwurf: false/' "$ziel" && rm -f "$ziel.bak"
    ok "entwurf: $(feld "$ziel" entwurf)"
  else
    ok "entwurf steht bereits auf false"
  fi

  heute=$(date +%Y-%m-%d); wert=$(feld "$ziel" datum)
  if [ "$wert" != "$heute" ]; then
    echo
    warn "datum: $wert — heute ist $heute."
    if frage "Auf heute setzen?"; then
      sed -i.bak "s/^datum:.*/datum: $heute/" "$ziel" && rm -f "$ziel.bak"
      ok "datum: $(feld "$ziel" datum)"
    else
      info "bleibt bei $wert — bewusst so."
    fi
  fi

  pruefe_datei "$ziel" erwartet_false || {
    frage "Trotz Befund weiter zum Bau?" || { weiter; return; }
  }

  echo
  echo "-- Anonymisierung, Arbeitsbaum"
  if [ -x "$PRUEFSKRIPT" ]; then
    "$PRUEFSKRIPT" || { frage "Trotz Befund weiter?" || { weiter; return; }; }
  else warn "$PRUEFSKRIPT nicht gefunden"; fi

  echo
  echo "-- Bau mit dem Artikel als Seite"
  bau_und_pruefe "$slug" "$sprache" erwartet_live || {
    frage "Trotz Befund weiter zum Commit?" || { weiter; return; }
  }

  command -v git >/dev/null 2>&1 || { echo; rot "git nicht gefunden — hier ist Schluss."; weiter; return; }

  echo
  echo "-- Was committet wuerde"
  (cd "$REPO" && git status --short)
  echo
  info "Es soll die Artikeldatei sein, sonst nichts Unerwartetes."
  frage "Nur diese Datei vormerken und committen?" || { weiter; return; }
  (cd "$REPO" && git add "$ziel")
  echo
  echo "-- Der Entwurfsschalter im Diff (die Zeile, auf die es ankommt)"
  (cd "$REPO" && git diff --cached -- "$ziel" | grep -E '^[+-](entwurf|datum):' || echo "    (keine Aenderung an entwurf/datum in diesem Commit)")
  echo
  (cd "$REPO" && git commit -m "Artikel: $slug veroeffentlicht" -m "Entwurfsschalter auf false, Bau und Anonymisierung geprueft.") || { weiter; return; }
  ok "committet"

  echo
  frage "Jetzt pushen? Danach baut Cloudflare, und die Seite geht live." || {
    info "Nicht gepusht. Der Commit liegt lokal."
    weiter; return
  }
  (cd "$REPO" && git push) && ok "gepusht"

  echo
  echo "$INFO Der Bau bei Cloudflare braucht ein bis zwei Minuten."
  frage "Jetzt nachmessen?" && nachmessen "$slug" "$sprache"

  if [ -e "$UEBERGABE/$slug.mdx" ]; then
    echo
    echo "-- Uebergabeordner"
    info "Die Fassung dort ist ab diesem Commit nur noch Herkunft, nicht mehr Quelle."
    frage "Original nach erledigt/ verschieben?" && raeume_weg "$UEBERGABE/$slug.mdx"
  fi
  echo
  echo "$INFO Danach von Hand, nicht vergessen:"
  echo "$INFO   1. Eintrag in claude/blog_artikel_index.md (Metadaten, kein Text)"
  echo "$INFO   2. Haken in claude/offene_punkte.md"
  echo "$INFO   3. Textaenderungen, die im Repo entstanden sind, ans Homelab-Projekt zuruecktragen: Zeile, alt, neu"
  weiter
}

nachmessen() {
  local slug="$1" sprache="${2:-de}" versuch code treffer
  titel "Nachmessung an der veroeffentlichten Seite"
  command -v curl >/dev/null 2>&1 || { rot "curl nicht gefunden."; return; }

  versuch=1
  while [ "$versuch" -le 10 ]; do
    treffer=$(curl -s "$SEITE/$sprache/" | grep -c "$slug")
    code=$(curl -s -o /dev/null -w '%{http_code}' "$SEITE/$sprache/artikel/$slug/")
    echo "    Versuch $versuch: Liste nennt den Artikel ${treffer}x · Artikelseite HTTP $code"
    if [ "$treffer" -ge 1 ] && [ "$code" = "200" ]; then break; fi
    versuch=$((versuch + 1))
    [ "$versuch" -le 10 ] && sleep 20
  done

  echo
  [ "${treffer:-0}" -ge 1 ] && ok "Der Artikel steht in der Liste" || rot "Der Artikel steht NICHT in der Liste"
  [ "${code:-000}" = "200" ] && ok "Die Artikelseite antwortet mit 200" || rot "Die Artikelseite antwortet mit $code"

  # Die Kontrollmessung: ohne sie beweist die 200 oben nichts.
  code=$(curl -s -o /dev/null -w '%{http_code}' "$SEITE/$sprache/gibt-es-nicht-$(date +%s)/")
  if [ "$code" = "404" ]; then ok "Ein erfundener Pfad antwortet mit 404 — die 200 oben bedeutet also etwas"
  else rot "Ein erfundener Pfad antwortet mit $code statt 404. Solange das so ist, beweist die 200 oben nichts."; fi
}

schritt_nachmessen() {
  local slug
  printf "\n    Dateiname ohne .mdx: "
  read -r slug
  [ -n "$slug" ] && nachmessen "$slug" de
  weiter
}

